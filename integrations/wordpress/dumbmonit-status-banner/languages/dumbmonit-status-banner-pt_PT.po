# Portuguese (Portugal) translation of DumbMonit Status Banner.
msgid ""
msgstr ""
"Project-Id-Version: DumbMonit Status Banner 2.0.0\n"
"Language: pt_PT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: dumbmonit-status-banner\n"

msgid "All systems operational"
msgstr "Todos os sistemas estão operacionais"

msgid "Maintenance in progress"
msgstr "Manutenção em curso"

msgid "Incident in progress"
msgstr "Incidente em curso"

#, php-format
msgid "%d service is down"
msgid_plural "%d services are down"
msgstr[0] "%d serviço está em baixo"
msgstr[1] "%d serviços estão em baixo"

#, php-format
msgid "Affected: %s"
msgstr "Afetados: %s"

msgid "Details"
msgstr "Detalhes"

msgid "Dismiss"
msgstr "Fechar"

msgid "DumbMonit status banner"
msgstr "Faixa de estado DumbMonit"

msgid "DumbMonit banner"
msgstr "Faixa DumbMonit"

msgid "Status page"
msgstr "Página de estado"

msgid "DumbMonit address"
msgstr "Endereço do DumbMonit"

msgid "Your DumbMonit server, for example https://monit.example.com. A private (LAN) address works."
msgstr "O seu servidor DumbMonit, por exemplo https://monit.example.com. Um endereço privado (LAN) também funciona."

msgid "Find status pages"
msgstr "Procurar páginas de estado"

msgid "Page address"
msgstr "Endereço da página"

msgid "Pick a page found on the server, or type its address: the part after /s/ in its link."
msgstr "Escolha uma página encontrada no servidor ou escreva o seu endereço: a parte depois de /s/ na sua ligação."

msgid "Choose a page"
msgstr "Escolher uma página"

msgid "Searching…"
msgstr "A procurar…"

msgid "Pick one of the pages found."
msgstr "Escolha uma das páginas encontradas."

msgid "No listed public page was found on this server."
msgstr "Não foi encontrada nenhuma página pública listada neste servidor."

msgid "This server does not list its pages (it may be older than this plugin). Type the page address instead."
msgstr "Este servidor não lista as suas páginas (pode ser mais antigo do que este plugin). Escreva antes o endereço da página."

#, php-format
msgid "The server could not be reached: %s"
msgstr "Não foi possível contactar o servidor: %s"

msgid "The search failed. Try again."
msgstr "A pesquisa falhou. Tente novamente."

msgid "The server did not answer with a DumbMonit document."
msgstr "O servidor não respondeu com um documento DumbMonit."

msgid "Services"
msgstr "Serviços"

msgid "Only the ticked services count; none ticked means all of them."
msgstr "Só contam os serviços assinalados; sem nenhum assinalado, contam todos."

msgid "Save a reachable page first to choose its services."
msgstr "Guarde primeiro uma página acessível para escolher os seus serviços."

msgid "Display"
msgstr "Apresentação"

msgid "Placement"
msgstr "Posição"

msgid "Bar at the top of every page"
msgstr "Barra no topo de cada página"

msgid "Bar at the bottom of every page"
msgstr "Barra no fundo de cada página"

msgid "Only where the [dumbmonit_status] shortcode or the widget is placed"
msgstr "Só onde estiverem o shortcode [dumbmonit_status] ou o widget"

msgid "When to show"
msgstr "Quando mostrar"

msgid "Only when something is wrong"
msgstr "Só quando algo está mal"

msgid "Always"
msgstr "Sempre"

msgid "Options"
msgstr "Opções"

msgid "Name the affected services"
msgstr "Indicar os serviços afetados"

msgid "Link to the status page"
msgstr "Ligação para a página de estado"

msgid "Visitors can dismiss the banner"
msgstr "Os visitantes podem fechar a faixa"

msgid "Cache duration"
msgstr "Duração da cache"

msgid "Seconds before DumbMonit is asked again, 15 to 3600."
msgstr "Segundos antes de voltar a consultar o DumbMonit, de 15 a 3600."

msgid "Colours"
msgstr "Cores"

msgid "Follow the status: green, amber, red or blue"
msgstr "Seguir o estado: verde, âmbar, vermelho ou azul"

msgid "Custom colours"
msgstr "Cores personalizadas"

msgid "Background, light mode"
msgstr "Fundo, modo claro"

msgid "Text, light mode"
msgstr "Texto, modo claro"

msgid "Background, dark mode"
msgstr "Fundo, modo escuro"

msgid "Text, dark mode"
msgstr "Texto, modo escuro"

msgid "Texts"
msgstr "Textos"

msgid "Leave a field empty to use the default text, translated for each visitor. {count} is replaced by the number of services down."
msgstr "Deixe um campo vazio para usar o texto predefinido, traduzido para cada visitante. {count} é substituído pelo número de serviços em baixo."

msgid "Invalid DumbMonit address: expected http:// or https:// followed by the server name. It was not saved."
msgstr "Endereço DumbMonit inválido: é esperado http:// ou https:// seguido do nome do servidor. Não foi guardado."

msgid "Invalid page address: 2 to 40 lowercase letters, digits or hyphens. It was not saved."
msgstr "Endereço de página inválido: 2 a 40 letras minúsculas, algarismos ou hífenes. Não foi guardado."

#, php-format
msgid "Saved, but the status page could not be fetched: %s"
msgstr "Guardado, mas não foi possível obter a página de estado: %s"

#, php-format
msgid "DumbMonit status banner: the status page cannot be fetched (%s). No banner is shown."
msgstr "Faixa de estado DumbMonit: não é possível obter a página de estado (%s). Nenhuma faixa é mostrada."

msgid "DumbMonit status"
msgstr "Estado DumbMonit"

msgid "The status of your DumbMonit page, with the settings of the banner."
msgstr "O estado da sua página DumbMonit, com as definições da faixa."

msgid "This widget uses the settings in Settings › DumbMonit banner."
msgstr "Este widget usa as definições em Definições › Faixa DumbMonit."
