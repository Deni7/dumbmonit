# Turkish translation of DumbMonit Status Banner.
msgid ""
msgstr ""
"Project-Id-Version: DumbMonit Status Banner 2.0.0\n"
"Language: tr_TR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: dumbmonit-status-banner\n"

msgid "All systems operational"
msgstr "Tüm sistemler çalışıyor"

msgid "Maintenance in progress"
msgstr "Bakım sürüyor"

msgid "Incident in progress"
msgstr "Olay sürüyor"

#, php-format
msgid "%d service is down"
msgid_plural "%d services are down"
msgstr[0] "%d hizmet çalışmıyor"
msgstr[1] "%d hizmet çalışmıyor"

#, php-format
msgid "Affected: %s"
msgstr "Etkilenenler: %s"

msgid "Details"
msgstr "Ayrıntılar"

msgid "Dismiss"
msgstr "Kapat"

msgid "DumbMonit status banner"
msgstr "DumbMonit durum banner’ı"

msgid "DumbMonit banner"
msgstr "DumbMonit banner’ı"

msgid "Status page"
msgstr "Durum sayfası"

msgid "DumbMonit address"
msgstr "DumbMonit adresi"

msgid "Your DumbMonit server, for example https://monit.example.com. A private (LAN) address works."
msgstr "DumbMonit sunucunuz, örneğin https://monit.example.com. Özel (LAN) bir adres de çalışır."

msgid "Find status pages"
msgstr "Durum sayfalarını bul"

msgid "Page address"
msgstr "Sayfa adresi"

msgid "Pick a page found on the server, or type its address: the part after /s/ in its link."
msgstr "Sunucuda bulunan bir sayfayı seçin ya da adresini yazın: bağlantısında /s/ sonrasındaki kısım."

msgid "Choose a page"
msgstr "Bir sayfa seçin"

msgid "Searching…"
msgstr "Aranıyor…"

msgid "Pick one of the pages found."
msgstr "Bulunan sayfalardan birini seçin."

msgid "No listed public page was found on this server."
msgstr "Bu sunucuda listelenmiş herkese açık sayfa bulunamadı."

msgid "This server does not list its pages (it may be older than this plugin). Type the page address instead."
msgstr "Bu sunucu sayfalarını listelemiyor (bu eklentiden eski olabilir). Bunun yerine sayfa adresini yazın."

#, php-format
msgid "The server could not be reached: %s"
msgstr "Sunucuya ulaşılamadı: %s"

msgid "The search failed. Try again."
msgstr "Arama başarısız oldu. Yeniden deneyin."

msgid "The server did not answer with a DumbMonit document."
msgstr "Sunucu bir DumbMonit belgesiyle yanıt vermedi."

msgid "Services"
msgstr "Hizmetler"

msgid "Only the ticked services count; none ticked means all of them."
msgstr "Yalnızca işaretli hizmetler hesaba katılır; hiçbiri işaretli değilse hepsi."

msgid "Save a reachable page first to choose its services."
msgstr "Hizmetlerini seçmek için önce erişilebilir bir sayfayı kaydedin."

msgid "Display"
msgstr "Görünüm"

msgid "Placement"
msgstr "Konum"

msgid "Bar at the top of every page"
msgstr "Her sayfanın üstünde bir çubuk"

msgid "Bar at the bottom of every page"
msgstr "Her sayfanın altında bir çubuk"

msgid "Only where the [dumbmonit_status] shortcode or the widget is placed"
msgstr "Yalnızca [dumbmonit_status] kısa kodunun veya bileşenin bulunduğu yerde"

msgid "When to show"
msgstr "Ne zaman gösterilsin"

msgid "Only when something is wrong"
msgstr "Yalnızca bir sorun olduğunda"

msgid "Always"
msgstr "Her zaman"

msgid "Options"
msgstr "Seçenekler"

msgid "Name the affected services"
msgstr "Etkilenen hizmetlerin adlarını göster"

msgid "Link to the status page"
msgstr "Durum sayfasına bağlantı"

msgid "Visitors can dismiss the banner"
msgstr "Ziyaretçiler banner’ı kapatabilir"

msgid "Cache duration"
msgstr "Önbellek süresi"

msgid "Seconds before DumbMonit is asked again, 15 to 3600."
msgstr "DumbMonit’e yeniden sorulmadan önceki saniye, 15 ile 3600 arası."

msgid "Colours"
msgstr "Renkler"

msgid "Follow the status: green, amber, red or blue"
msgstr "Durumu izle: yeşil, kehribar, kırmızı veya mavi"

msgid "Custom colours"
msgstr "Özel renkler"

msgid "Background, light mode"
msgstr "Arka plan, açık mod"

msgid "Text, light mode"
msgstr "Metin, açık mod"

msgid "Background, dark mode"
msgstr "Arka plan, koyu mod"

msgid "Text, dark mode"
msgstr "Metin, koyu mod"

msgid "Texts"
msgstr "Metinler"

msgid "Leave a field empty to use the default text, translated for each visitor. {count} is replaced by the number of services down."
msgstr "Her ziyaretçi için çevrilen varsayılan metni kullanmak üzere alanı boş bırakın. {count}, çalışmayan hizmet sayısıyla değiştirilir."

msgid "Invalid DumbMonit address: expected http:// or https:// followed by the server name. It was not saved."
msgstr "Geçersiz DumbMonit adresi: http:// veya https:// ve ardından sunucu adı bekleniyor. Kaydedilmedi."

msgid "Invalid page address: 2 to 40 lowercase letters, digits or hyphens. It was not saved."
msgstr "Geçersiz sayfa adresi: 2 ile 40 arası küçük harf, rakam veya kısa çizgi. Kaydedilmedi."

#, php-format
msgid "Saved, but the status page could not be fetched: %s"
msgstr "Kaydedildi, ancak durum sayfası alınamadı: %s"

#, php-format
msgid "DumbMonit status banner: the status page cannot be fetched (%s). No banner is shown."
msgstr "DumbMonit durum banner’ı: durum sayfası alınamıyor (%s). Banner gösterilmiyor."

msgid "DumbMonit status"
msgstr "DumbMonit durumu"

msgid "The status of your DumbMonit page, with the settings of the banner."
msgstr "DumbMonit sayfanızın durumu, banner ayarlarıyla."

msgid "This widget uses the settings in Settings › DumbMonit banner."
msgstr "Bu bileşen Ayarlar › DumbMonit banner’ı bölümündeki ayarları kullanır."
