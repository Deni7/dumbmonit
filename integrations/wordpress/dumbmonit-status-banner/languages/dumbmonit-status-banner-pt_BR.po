# Portuguese (Brazil) translation of DumbMonit Status Banner.
msgid ""
msgstr ""
"Project-Id-Version: DumbMonit Status Banner 2.0.0\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: dumbmonit-status-banner\n"

msgid "All systems operational"
msgstr "Todos os sistemas estão operacionais"

msgid "Maintenance in progress"
msgstr "Manutenção em andamento"

msgid "Incident in progress"
msgstr "Incidente em andamento"

#, php-format
msgid "%d service is down"
msgid_plural "%d services are down"
msgstr[0] "%d serviço está fora do ar"
msgstr[1] "%d serviços estão fora do ar"

#, php-format
msgid "Affected: %s"
msgstr "Afetados: %s"

msgid "Details"
msgstr "Detalhes"

msgid "Dismiss"
msgstr "Fechar"

msgid "DumbMonit status banner"
msgstr "Banner de status do DumbMonit"

msgid "DumbMonit banner"
msgstr "Banner do DumbMonit"

msgid "Status page"
msgstr "Página de status"

msgid "DumbMonit address"
msgstr "Endereço do DumbMonit"

msgid "Your DumbMonit server, for example https://monit.example.com. A private (LAN) address works."
msgstr "Seu servidor DumbMonit, por exemplo https://monit.example.com. Um endereço privado (LAN) também funciona."

msgid "Find status pages"
msgstr "Buscar páginas de status"

msgid "Page address"
msgstr "Endereço da página"

msgid "Pick a page found on the server, or type its address: the part after /s/ in its link."
msgstr "Escolha uma página encontrada no servidor ou digite o endereço dela: a parte depois de /s/ no link."

msgid "Choose a page"
msgstr "Escolher uma página"

msgid "Searching…"
msgstr "Buscando…"

msgid "Pick one of the pages found."
msgstr "Escolha uma das páginas encontradas."

msgid "No listed public page was found on this server."
msgstr "Nenhuma página pública listada foi encontrada neste servidor."

msgid "This server does not list its pages (it may be older than this plugin). Type the page address instead."
msgstr "Este servidor não lista as páginas dele (talvez seja mais antigo que este plugin). Digite o endereço da página."

#, php-format
msgid "The server could not be reached: %s"
msgstr "Não foi possível acessar o servidor: %s"

msgid "The search failed. Try again."
msgstr "A busca falhou. Tente de novo."

msgid "The server did not answer with a DumbMonit document."
msgstr "O servidor não respondeu com um documento do DumbMonit."

msgid "Services"
msgstr "Serviços"

msgid "Only the ticked services count; none ticked means all of them."
msgstr "Só contam os serviços marcados; se nenhum estiver marcado, contam todos."

msgid "Save a reachable page first to choose its services."
msgstr "Salve primeiro uma página acessível para escolher os serviços dela."

msgid "Display"
msgstr "Exibição"

msgid "Placement"
msgstr "Posição"

msgid "Bar at the top of every page"
msgstr "Barra no topo de todas as páginas"

msgid "Bar at the bottom of every page"
msgstr "Barra no rodapé de todas as páginas"

msgid "Only where the [dumbmonit_status] shortcode or the widget is placed"
msgstr "Só onde estiverem o shortcode [dumbmonit_status] ou o widget"

msgid "When to show"
msgstr "Quando mostrar"

msgid "Only when something is wrong"
msgstr "Só quando algo der errado"

msgid "Always"
msgstr "Sempre"

msgid "Options"
msgstr "Opções"

msgid "Name the affected services"
msgstr "Nomear os serviços afetados"

msgid "Link to the status page"
msgstr "Link para a página de status"

msgid "Visitors can dismiss the banner"
msgstr "Visitantes podem fechar o banner"

msgid "Cache duration"
msgstr "Duração do cache"

msgid "Seconds before DumbMonit is asked again, 15 to 3600."
msgstr "Segundos até consultar o DumbMonit de novo, de 15 a 3600."

msgid "Colours"
msgstr "Cores"

msgid "Follow the status: green, amber, red or blue"
msgstr "Seguir o status: verde, âmbar, vermelho ou azul"

msgid "Custom colours"
msgstr "Cores personalizadas"

msgid "Background, light mode"
msgstr "Fundo, modo claro"

msgid "Text, light mode"
msgstr "Texto, modo claro"

msgid "Background, dark mode"
msgstr "Fundo, modo escuro"

msgid "Text, dark mode"
msgstr "Texto, modo escuro"

msgid "Texts"
msgstr "Textos"

msgid "Leave a field empty to use the default text, translated for each visitor. {count} is replaced by the number of services down."
msgstr "Deixe um campo vazio para usar o texto padrão, traduzido para cada visitante. {count} é substituído pelo número de serviços fora do ar."

msgid "Invalid DumbMonit address: expected http:// or https:// followed by the server name. It was not saved."
msgstr "Endereço do DumbMonit inválido: esperado http:// ou https:// seguido do nome do servidor. Ele não foi salvo."

msgid "Invalid page address: 2 to 40 lowercase letters, digits or hyphens. It was not saved."
msgstr "Endereço de página inválido: de 2 a 40 letras minúsculas, dígitos ou hifens. Ele não foi salvo."

#, php-format
msgid "Saved, but the status page could not be fetched: %s"
msgstr "Salvo, mas não foi possível obter a página de status: %s"

#, php-format
msgid "DumbMonit status banner: the status page cannot be fetched (%s). No banner is shown."
msgstr "Banner de status do DumbMonit: não é possível obter a página de status (%s). Nenhum banner é exibido."

msgid "DumbMonit status"
msgstr "Status do DumbMonit"

msgid "The status of your DumbMonit page, with the settings of the banner."
msgstr "O status da sua página do DumbMonit, com as configurações do banner."

msgid "This widget uses the settings in Settings › DumbMonit banner."
msgstr "Este widget usa as configurações em Configurações › Banner do DumbMonit."
